# Copy thanh .env tren server (deploy.sh tu tao neu chua co). KHONG commit file .env.

# Token cua Cloudflare Tunnel: Zero Trust > Networks > Tunnels > (tunnel) > Configure > Install connector.
# Ai co token nay deu chay duoc connector cho domain, nen giu bi mat.
TUNNEL_TOKEN=

# Cong web tren may chu. Phai khop Public Hostname trong Cloudflare:
#   miv2026.p-tech.xyz  ->  Service: HTTP  ->  URL: localhost:3001
WEB_PORT=3001
